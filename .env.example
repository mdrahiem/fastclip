# --- LLM (set OpenRouter OR OpenAI) ---
# OpenRouter (recommended if you don’t use OpenAI directly)
OPENROUTER_API_KEY=
# Base URL for the OpenAI-compatible API (default is OpenRouter)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional; OpenRouter suggests these for routing/analytics
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_NAME=video-gen

# OpenAI — only if OPENROUTER_API_KEY is unset
# OPENAI_API_KEY=

# Model: OpenRouter uses slugs like openai/gpt-4o-mini; OpenAI uses gpt-4o-mini
OPENAI_MODEL=openai/gpt-4o-mini

# --- SQLite jobs DB ---
# Relative paths are resolved from the process cwd (usually apps/web when you run dev/worker).
# Example: file:./data/app.db -> apps/web/data/app.db
DATABASE_URL=file:./data/app.db

SESSION_SECRET=change-me-min-32-chars-please-change-me
JOB_RETENTION_MS=3600000
MAX_POST_CHARS=10000
MAX_MUSIC_BYTES=15728640
MAX_MUSIC_DURATION_SEC=120
